generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExamUploadStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PracticeSessionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model User {
  id        String   @id @default(cuid())
  phone     String?  @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  children Child[]
}

model Child {
  id              String   @id @default(cuid())
  userId          String
  name            String
  age             Int?
  grade           String?
  province        String?
  city            String?
  textbookVersion String?
  birthday        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  examUploads          ExamUpload[]
  wrongQuestions       WrongQuestion[]
  knowledgePointStates ChildKnowledgePoint[]
  practiceSessions     PracticeSession[]

  @@index([userId])
}

model Textbook {
  id        String   @id @default(cuid())
  subject   String
  grade     String
  version   String?
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapters Chapter[]

  @@index([subject, grade])
}

model Chapter {
  id         String   @id @default(cuid())
  textbookId String
  title      String
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  textbook        Textbook         @relation(fields: [textbookId], references: [id], onDelete: Cascade)
  knowledgePoints KnowledgePoint[]

  @@index([textbookId, order])
}

model KnowledgePoint {
  id          String   @id @default(cuid())
  chapterId   String
  name        String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chapter              Chapter               @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  wrongQuestions       WrongQuestion[]
  childKnowledgePoints ChildKnowledgePoint[]
  practiceQuestions    PracticeQuestion[]

  @@index([chapterId, order])
}

model ExamUpload {
  id          String           @id @default(cuid())
  childId     String
  title       String
  fileUrl     String?
  rawText     String?
  imageCount  Int              @default(0)
  status      ExamUploadStatus @default(PENDING)
  uploadedAt  DateTime         @default(now())
  processedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  child          Child           @relation(fields: [childId], references: [id], onDelete: Cascade)
  wrongQuestions WrongQuestion[]

  @@index([childId, uploadedAt])
}

model WrongQuestion {
  id                 String   @id @default(cuid())
  childId            String
  examUploadId       String?
  knowledgePointId   String?
  questionText       String
  studentAnswer      String?
  correctAnswer      String?
  errorReason        String?
  knowledgePointText String?
  answerText         String?
  analysis           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  child          Child           @relation(fields: [childId], references: [id], onDelete: Cascade)
  examUpload     ExamUpload?     @relation(fields: [examUploadId], references: [id], onDelete: SetNull)
  knowledgePoint KnowledgePoint? @relation(fields: [knowledgePointId], references: [id], onDelete: SetNull)

  @@index([childId, createdAt])
  @@index([knowledgePointId])
}

model ChildKnowledgePoint {
  id                 String   @id @default(cuid())
  childId            String
  knowledgePointId   String?
  knowledgePointText String?
  masteryScore       Float    @default(0)
  lastPracticedAt    DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  child          Child           @relation(fields: [childId], references: [id], onDelete: Cascade)
  knowledgePoint KnowledgePoint? @relation(fields: [knowledgePointId], references: [id], onDelete: Cascade)

  @@unique([childId, knowledgePointId])
  @@unique([childId, knowledgePointText])
  @@index([knowledgePointId])
}

model PracticeSession {
  id                 String                @id @default(cuid())
  childId            String
  title              String
  status             PracticeSessionStatus @default(ACTIVE)
  knowledgePointText String?
  questionCount      Int                   @default(0)
  difficulty         String?
  questionType       String?
  correctCount       Int?
  accuracy           Int?
  masteryBefore      String?
  masteryAfter       String?
  startedAt          DateTime              @default(now())
  endedAt            DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  child     Child              @relation(fields: [childId], references: [id], onDelete: Cascade)
  questions PracticeQuestion[]

  @@index([childId, startedAt])
}

model PracticeQuestion {
  id                 String   @id @default(cuid())
  practiceSessionId  String
  knowledgePointId   String?
  knowledgePointText String?
  order              Int      @default(0)
  questionText       String
  options            Json?
  answerText         String?
  analysis           String?
  userAnswer         String?
  isCorrect          Boolean?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  practiceSession PracticeSession @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)
  knowledgePoint  KnowledgePoint? @relation(fields: [knowledgePointId], references: [id], onDelete: SetNull)

  @@index([practiceSessionId])
  @@index([knowledgePointId])
}
