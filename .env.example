# Production/runtime defaults
NODE_ENV=production
PORT=8080
HOSTNAME=0.0.0.0

# PostgreSQL connection string. Installer creates a local PostgreSQL database by default.
DATABASE_URL="postgresql://ai_learning:change-me@127.0.0.1:5432/ai_learning_for_children?schema=public"

# Set CHILDREN_STORE=memory only for temporary demo mode without PostgreSQL.
# CHILDREN_STORE=memory

# AI provider abstraction. Only mock is implemented for now.
AI_PROVIDER=mock

# Initial administrator is only used when .data/users.json does not exist yet.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-before-production

# Set to "true" only when the H5 site is served over HTTPS.
# Keep false/empty for local HTTP test environments, otherwise browsers will reject login cookies.
AUTH_COOKIE_SECURE=false
