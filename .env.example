# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_learning_for_children?schema=public"

# AI provider abstraction. Only mock is implemented for now.
AI_PROVIDER="mock"

# Optional: force children profile API to use in-memory development storage.
# CHILDREN_STORE="memory"

# Set to "true" only when the H5 site is served over HTTPS.
# Keep false/empty for local HTTP test environments, otherwise browsers will reject login cookies.
# AUTH_COOKIE_SECURE="true"
